# Conexión a PostgreSQL:  postgresql+psycopg://USUARIO:CONTRASEÑA@HOST:PUERTO/BASE
DATABASE_URL=postgresql+psycopg://postgres:TU_CONTRASEÑA@localhost:5432/transporte_api

# Clave para firmar los JWT. Genera una con:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambia-esta-clave-por-una-larga-y-secreta
TOKEN_MINUTOS=60

# Primer administrador (se crea solo si no hay ninguno)
ADMIN_USUARIO=admin
ADMIN_PASSWORD=admin123

# Crear clientes, conductores, camiones y envíos de ejemplo si la base está vacía
CARGAR_DEMO=true

# Rate limit por IP
LIMITE_GENERAL=60/minute
LIMITE_LOGIN=5/minute
LIMITE_RASTREO=20/minute

# Sitios web que pueden llamar a la API desde un navegador (* = cualquiera)
CORS_ORIGENES=*
