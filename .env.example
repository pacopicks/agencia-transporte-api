# Conexión a PostgreSQL local:
#   postgresql+psycopg://USUARIO:CONTRASEÑA@HOST:PUERTO/NOMBRE_DE_LA_BASE
# La base "transporte" se crea sola la primera vez que arranca la API.
DATABASE_URL=postgresql+psycopg://postgres:TU_CONTRASEÑA@localhost:5432/transporte

# Clave para firmar los JWT (pon un texto largo y aleatorio; si la cambias, las sesiones abiertas se cierran)
SECRET_KEY=cambia-esta-clave-por-un-texto-largo-y-secreto-1234567890
TOKEN_MINUTOS=480

# Primer administrador (solo se crea si la tabla de usuarios está vacía)
ADMIN_USUARIO=admin
ADMIN_PASSWORD=admin123

# Precio del diésel en MXN por litro (el modelo lo usa para calcular costos)
PRECIO_DIESEL=25.50

# Cargar ciudades, carreteras, camiones, envíos y usuarios de ejemplo si la base está vacía
CARGAR_DEMO=true

# CORS: sitios web que pueden llamar a la API desde el navegador (separados por coma).
# El panel se sirve desde la misma API y no necesita estar aquí; 5173 es "npm run dev".
CORS_ORIGENES=http://localhost:5173,http://127.0.0.1:5173

# Rate limit (peticiones por minuto)
LIMITE_POR_MINUTO=120
LIMITE_LOGIN_POR_MINUTO=10
LIMITE_MODELO_POR_MINUTO=10
